<Page x:Class="DanceLearning.Views.ProfileView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundDarkBrush}"
      Title="Личный кабинет">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- PROFILE HEADER -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundCardBrush}"
                    CornerRadius="10" Padding="20" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar -->
                    <Border Grid.Column="0" Width="60" Height="60" CornerRadius="30"
                            Background="{StaticResource AccentBrush}" Margin="0,0,16,0">
                        <TextBlock Text="A" Foreground="White" FontSize="22" FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Name + badges -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameText" Text="Алексей"
                                   Style="{StaticResource HeadingStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="Уровень 5 · Опытный"
                                           Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
                            </Border>
                            <TextBlock Text="🔥 5 дней подряд"
                                       Foreground="#FFF59E0B" FontSize="12" FontFamily="Segoe UI"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Points -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="PointsText" Text="1 250"
                                   Style="{StaticResource HeadingStyle}" FontSize="28"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="очков" Style="{StaticResource BodyStyle}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- STATISTICS -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource BackgroundCardBrush}"
                        CornerRadius="10" Padding="16" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock x:Name="LessonsCompletedText" Text="7"
                                   Style="{StaticResource HeadingStyle}"/>
                        <TextBlock Text="Уроков пройдено"
                                   Style="{StaticResource BodyStyle}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource BackgroundCardBrush}"
                        CornerRadius="10" Padding="16" Margin="6,0">
                    <StackPanel>
                        <TextBlock x:Name="BundlesLearnedText" Text="3"
                                   Style="{StaticResource HeadingStyle}"/>
                        <TextBlock Text="Связок изучено"
                                   Style="{StaticResource BodyStyle}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource BackgroundCardBrush}"
                        CornerRadius="10" Padding="16" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="4.5 ч" Style="{StaticResource HeadingStyle}"/>
                        <TextBlock Text="Часов тренировок"
                                   Style="{StaticResource BodyStyle}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- PROGRESS BY STYLES + WEEK CALENDAR -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Progress by style -->
                <Border Grid.Column="0" Background="{StaticResource BackgroundCardBrush}"
                        CornerRadius="10" Padding="16" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Прогресс по стилям" Style="{StaticResource SubheadingStyle}"/>
                        <StackPanel Margin="0,12,0,0">
                            <Grid>
                                <TextBlock Text="Общий прогресс" Style="{StaticResource BodyStyle}"/>
                                <TextBlock Text="42%" HorizontalAlignment="Right"
                                           Style="{StaticResource BodyStyle}" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <ProgressBar x:Name="OverallProgressBar" Margin="0,5,0,0"
                                         Style="{StaticResource GradientProgressBarStyle}"
                                         Minimum="0" Maximum="100" Value="42"/>
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0">
                            <Grid>
                                <TextBlock Text="Hip-Hop" Style="{StaticResource BodyStyle}"/>
                                <TextBlock Text="65%" HorizontalAlignment="Right"
                                           Style="{StaticResource BodyStyle}" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <ProgressBar x:Name="HipHopProgressBar" Margin="0,5,0,0"
                                         Style="{StaticResource GradientProgressBarStyle}"
                                         Minimum="0" Maximum="100" Value="65"/>
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0">
                            <Grid>
                                <TextBlock Text="Breakdance" Style="{StaticResource BodyStyle}"/>
                                <TextBlock Text="30%" HorizontalAlignment="Right"
                                           Style="{StaticResource BodyStyle}" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <ProgressBar x:Name="BreakProgressBar" Margin="0,5,0,0"
                                         Style="{StaticResource GradientProgressBarStyle}"
                                         Minimum="0" Maximum="100" Value="30"/>
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0">
                            <Grid>
                                <TextBlock Text="K-Pop Cover Dance" Style="{StaticResource BodyStyle}"/>
                                <TextBlock Text="80%" HorizontalAlignment="Right"
                                           Style="{StaticResource BodyStyle}" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <ProgressBar x:Name="KPopProgressBar" Margin="0,5,0,0"
                                         Style="{StaticResource GradientProgressBarStyle}"
                                         Minimum="0" Maximum="100" Value="80"/>
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0">
                            <Grid>
                                <TextBlock Text="High Heels" Style="{StaticResource BodyStyle}"/>
                                <TextBlock Text="20%" HorizontalAlignment="Right"
                                           Style="{StaticResource BodyStyle}" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <ProgressBar x:Name="HighHeelsProgressBar" Margin="0,5,0,0"
                                         Style="{StaticResource GradientProgressBarStyle}"
                                         Minimum="0" Maximum="100" Value="20"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Week calendar -->
                <Border Grid.Column="1" Background="{StaticResource BackgroundCardBrush}"
                        CornerRadius="10" Padding="16" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Тренировочная неделя" Style="{StaticResource SubheadingStyle}"/>
                        <UniformGrid x:Name="WeekGrid" Columns="7" Rows="1" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- PLAYLIST -->
            <Border Grid.Row="3" Background="{StaticResource BackgroundCardBrush}"
                    CornerRadius="10" Padding="16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Плейлист на неделю" Style="{StaticResource SubheadingStyle}"/>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="+ Добавить"
                                Click="AddLesson_Click"/>
                    </Grid>
                    <ListBox x:Name="PlaylistListBox" Margin="0,10,0,0"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource StepListItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource SubheadingStyle}" FontSize="13"/>
                                        <TextBlock Text="{Binding Day}"
                                                   Style="{StaticResource BodyStyle}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource IconButtonStyle}"
                                            Tag="{Binding}"
                                            Click="RemovePlaylistItem_Click"
                                            Content="✕"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
