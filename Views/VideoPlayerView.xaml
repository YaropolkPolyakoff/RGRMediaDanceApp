<Page x:Class="DanceLearning.Views.VideoPlayerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundDarkBrush}"
      Title="Видеоплеер">
    <Page.Resources>
        <!-- Loop segment indicator animation -->
        <Storyboard x:Key="LoopPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LoopIndicator"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.3" Duration="0:0:0.8"
                             AutoReverse="True"/>
        </Storyboard>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*" MaxWidth="320"/>
        </Grid.ColumnDefinitions>
        <!-- ======== LEFT: VIDEO PLAYER ======== -->
        <Grid Grid.Column="0" Margin="24,16,12,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Current lesson title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="LessonTitleText"
                           Text="Выберите урок из каталога"
                           Style="{StaticResource SubheadingStyle}"
                           FontSize="18"/>
                <TextBlock x:Name="StyleNameText"
                           Text=""
                           Style="{StaticResource BodyStyle}"
                           Margin="0,2,0,0"/>
            </StackPanel>
            <!-- Video surface -->
            <Border Grid.Row="1" CornerRadius="12" ClipToBounds="True"
                    Background="#FF080810">
                <Grid>
                    <!-- MediaElement with optional mirror transform -->
                    <MediaElement x:Name="VideoPlayer"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  Stretch="Uniform"
                                  MediaOpened="VideoPlayer_MediaOpened"
                                  MediaEnded="VideoPlayer_MediaEnded"
                                  MediaFailed="VideoPlayer_MediaFailed">
                        <MediaElement.RenderTransformOrigin>0.5,0.5</MediaElement.RenderTransformOrigin>
                        <MediaElement.RenderTransform>
                            <ScaleTransform x:Name="VideoMirrorTransform" ScaleX="1" ScaleY="1"/>
                        </MediaElement.RenderTransform>
                    </MediaElement>
                    <!-- Placeholder when no video loaded -->
                    <StackPanel x:Name="NoVideoPlaceholder"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Opacity="0.4">
                        <Canvas Width="64" Height="64" HorizontalAlignment="Center">
                            <Path Data="M4,4 L60,32 L4,60 Z"
                                  Fill="{StaticResource TextSecondaryBrush}"/>
                        </Canvas>
                        <TextBlock Text="Видео не загружено" Style="{StaticResource BodyStyle}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- ── CONTROLS PANEL ── -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <!-- Seek bar -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Grid.Column="0"
                               Text="0:00" Style="{StaticResource BodyStyle}"
                               VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1"
                            Style="{StaticResource PlayerSliderStyle}"
                            Minimum="0" Maximum="100" Value="0"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            ValueChanged="SeekSlider_ValueChanged"
                            PreviewMouseDown="SeekSlider_PreviewMouseDown"
                            PreviewMouseUp="SeekSlider_PreviewMouseUp"/>
                    <TextBlock x:Name="TotalTimeText" Grid.Column="2"
                               Text="0:00" Style="{StaticResource BodyStyle}"
                               VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"/>
                </Grid>
                <!-- Loop segment markers row -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LoopIndicator" Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="11" FontFamily="Segoe UI"
                               VerticalAlignment="Center" Margin="0,0,8,0">
                        <Run Text="⟳ LOOP "/>
                        <Run x:Name="LoopRangeText" Text=""/>
                    </TextBlock>
                </Grid>
                <!-- Main control buttons row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Left group: speed + mirror + loop -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Speed selector -->
                        <Border Background="#FF1A1A2E" CornerRadius="6" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="Speed05Btn" Style="{StaticResource IconButtonStyle}"
                                        Click="Speed05_Click" ToolTip="0.5x — замедление">
                                    <TextBlock Text="0.5×" FontSize="11" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Button>
                                <Button x:Name="Speed075Btn" Style="{StaticResource IconButtonStyle}"
                                        Click="Speed075_Click" ToolTip="0.75x">
                                    <TextBlock Text="0.75×" FontSize="11" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Button>
                                <Button x:Name="Speed1Btn" Style="{StaticResource IconButtonStyle}"
                                        Click="Speed1_Click" ToolTip="1x — нормальная скорость">
                                    <TextBlock Text="1×" FontSize="11" FontFamily="Segoe UI"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                        <!-- Mirror button -->
                                Margin="6,0,0,0"
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="Mirror_Click" ToolTip="Зеркальное отражение">
                            <Canvas Width="20" Height="20">
                                <Path Data="M10,2 L10,18 M2,6 L10,10 L2,14 M18,6 L10,10 L18,14"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Button>
                        <!-- Loop segment button -->
                                Margin="6,0,0,0"
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="LoopSegment_Click" ToolTip="Зациклить отрезок (A-B Loop)">
                            <Canvas Width="20" Height="20">
                                <Path Data="M2,10 C2,5 7,2 12,4 M18,10 C18,15 13,18 8,16"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.8" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Data="M12,2 L14,6 L10,5 Z M8,18 L6,14 L10,15 Z"
                                      Fill="{StaticResource TextSecondaryBrush}"/>
                            </Canvas>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Rewind 5s -->
                        <Button Style="{StaticResource IconButtonStyle}" Click="Rewind_Click" ToolTip="−5 секунд">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,4 L4,12 L12,20 M20,4 L12,12 L20,20"
                                      Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="2" Fill="Transparent"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Button>
                        <!-- Play/Pause -->
                        <Button x:Name="PlayPauseBtn"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="48" Height="48" Padding="0"
                                Width="48" Height="48" Padding="0" Margin="8,0"
                            <Canvas x:Name="PlayIcon" Width="20" Height="20">
                                <Path x:Name="PlayPath" Data="M4,2 L18,10 L4,18 Z" Fill="White"/>
                            </Canvas>
                        </Button>
                        <!-- Forward 5s -->
                        <Button Style="{StaticResource IconButtonStyle}" Click="Forward_Click" ToolTip="+5 секунд">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4,4 L12,12 L4,20 M12,4 L20,12 L12,20"
                                      Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="2" Fill="Transparent"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Button>
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                    <!-- Right group: volume -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Canvas Width="20" Height="20" VerticalAlignment="Center">
                            <Path Data="M2,7 H7 L13,2 V18 L7,13 H2 Z"
                                  Fill="{StaticResource TextSecondaryBrush}"/>
                            <Path Data="M15,7 C17,8 17,12 15,13 M17,4 C21,7 21,13 17,16"
                                  Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeThickness="1.5" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                        <Slider x:Name="VolumeSlider"
                                Width="80" VerticalAlignment="Center" Margin="8,0,0,0"
                                Minimum="0" Maximum="1" Value="0.8"
                                Width="80" VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
        <!-- ======== RIGHT: STEPS LIST ======== -->
        <Grid Grid.Column="1" Margin="12,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Шаги связки" Style="{StaticResource SubheadingStyle}"/>
                <TextBlock Text="Нажмите на шаг для перехода" Style="{StaticResource BodyStyle}" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Row="1" Background="{StaticResource BackgroundCardBrush}" CornerRadius="12">
                <ListBox x:Name="StepsList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource StepListItemStyle}"
                         SelectionChanged="StepsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Step number circle -->
                                <Border Grid.Column="0" Width="26" Height="26"
                                        CornerRadius="13" VerticalAlignment="Center"
                                        Background="{StaticResource AccentGradientBrush}">
                                    <TextBlock Text="{Binding Number}"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Step info -->
                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource SubheadingStyle}"
                                               FontSize="13"/>
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource BodyStyle}"
                                               FontSize="11" TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- Completion checkmark -->
                                <Canvas Grid.Column="2" Width="16" Height="16" VerticalAlignment="Center">
                                    <Canvas.Style>
                                        <Style TargetType="Canvas">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Canvas.Style>
                                    <Ellipse Width="16" Height="16" Fill="#FF22C55E"/>
                                    <Path Data="M4,8 L7,11 L12,5"
                                          Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
</Page>
