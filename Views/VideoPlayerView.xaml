<Page x:Class="DanceLearning.Views.VideoPlayerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundDarkBrush}"
      Title="Видеоплеер">
    <Page.Resources>
        <Storyboard x:Key="LoopPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LoopIndicator"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.3" Duration="0:0:0.8"
                             AutoReverse="True"/>
        </Storyboard>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*" MaxWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: video player -->
        <Grid Grid.Column="0" Margin="20,16,10,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Lesson title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="LessonTitleText"
                           Text="Выберите урок из каталога"
                           Style="{StaticResource SubheadingStyle}"/>
                <TextBlock x:Name="StyleNameText"
                           Text=""
                           Style="{StaticResource BodyStyle}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Video surface -->
            <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True" Background="#FF0E0E1A">
                <Grid>
                    <MediaElement x:Name="VideoPlayer"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  Stretch="Uniform"
                                  MediaOpened="VideoPlayer_MediaOpened"
                                  MediaEnded="VideoPlayer_MediaEnded"
                                  MediaFailed="VideoPlayer_MediaFailed">
                        <MediaElement.RenderTransformOrigin>0.5,0.5</MediaElement.RenderTransformOrigin>
                        <MediaElement.RenderTransform>
                            <ScaleTransform x:Name="VideoMirrorTransform" ScaleX="1" ScaleY="1"/>
                        </MediaElement.RenderTransform>
                    </MediaElement>
                    <!-- No-video placeholder -->
                    <StackPanel x:Name="NoVideoPlaceholder"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Opacity="0.4">
                        <TextBlock Text="▶" FontSize="48"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Видео не загружено"
                                   Style="{StaticResource BodyStyle}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Controls -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <!-- Seek bar -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Grid.Column="0"
                               Text="0:00" Style="{StaticResource BodyStyle}"
                               VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1"
                            Style="{StaticResource PlayerSliderStyle}"
                            Minimum="0" Maximum="100" Value="0"
                            VerticalAlignment="Center" IsEnabled="False"
                            ValueChanged="SeekSlider_ValueChanged"
                            PreviewMouseDown="SeekSlider_PreviewMouseDown"
                            PreviewMouseUp="SeekSlider_PreviewMouseUp"/>
                    <TextBlock x:Name="TotalTimeText" Grid.Column="2"
                               Text="0:00" Style="{StaticResource BodyStyle}"
                               VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"/>
                </Grid>

                <!-- Loop indicator -->
                <TextBlock x:Name="LoopIndicator"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11" FontFamily="Segoe UI"
                           Margin="0,0,0,8">
                    <Run Text="⟳ LOOP "/>
                    <Run x:Name="LoopRangeText" Text=""/>
                </TextBlock>

                <!-- Playback controls row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: speed + mirror + loop -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource BackgroundCardBrush}" CornerRadius="6" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="Speed05Btn" Style="{StaticResource IconButtonStyle}"
                                        Click="Speed05_Click" ToolTip="0.5× — замедление">
                                    <TextBlock Text="0.5×" FontSize="12" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Button>
                                <Button x:Name="Speed075Btn" Style="{StaticResource IconButtonStyle}"
                                        Click="Speed075_Click" ToolTip="0.75×">
                                    <TextBlock Text="0.75×" FontSize="12" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Button>
                                <Button x:Name="Speed1Btn" Style="{StaticResource IconButtonStyle}"
                                        Click="Speed1_Click" ToolTip="1× — нормальная скорость">
                                    <TextBlock Text="1×" FontSize="12" FontFamily="Segoe UI"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource IconButtonStyle}" Margin="6,0,0,0"
                                Click="Mirror_Click" ToolTip="Зеркальное отражение">
                            <TextBlock Text="⇄" FontSize="16"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Margin="4,0,0,0"
                                Click="LoopSegment_Click" ToolTip="Зациклить отрезок (A-B Loop)">
                            <TextBlock Text="⟳" FontSize="16"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>

                    <!-- Center: rewind / play / forward -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" Click="Rewind_Click" ToolTip="−5 секунд">
                            <TextBlock Text="⏮" FontSize="18"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Button>
                        <Button x:Name="PlayPauseBtn"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="44" Height="44" Padding="0" Margin="8,0"
                                Click="PlayPause_Click">
                            <TextBlock x:Name="PlayPauseText" Text="▶" FontSize="16" Foreground="White"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="Forward_Click" ToolTip="+5 секунд">
                            <TextBlock Text="⏭" FontSize="18"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>

                    <!-- Right: volume -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="🔊" FontSize="14" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Slider x:Name="VolumeSlider"
                                Style="{StaticResource PlayerSliderStyle}"
                                Width="80" VerticalAlignment="Center" Margin="6,0,0,0"
                                Minimum="0" Maximum="1" Value="0.8"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- RIGHT: steps list -->
        <Grid Grid.Column="1" Margin="10,16,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Шаги связки" Style="{StaticResource SubheadingStyle}"/>
                <TextBlock Text="Нажмите шаг чтобы отметить"
                           Style="{StaticResource BodyStyle}" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Row="1" Background="{StaticResource BackgroundCardBrush}" CornerRadius="8">
                <ListBox x:Name="StepsList"
                         Background="Transparent" BorderThickness="0" Padding="8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource StepListItemStyle}"
                         SelectionChanged="StepsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24"
                                        CornerRadius="12" VerticalAlignment="Center"
                                        Background="{StaticResource AccentGradientBrush}">
                                    <TextBlock Text="{Binding Number}"
                                               FontSize="11" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource SubheadingStyle}" FontSize="13"/>
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource BodyStyle}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Canvas Grid.Column="2" Width="16" Height="16" VerticalAlignment="Center">
                                    <Canvas.Style>
                                        <Style TargetType="Canvas">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Canvas.Style>
                                    <Ellipse Width="16" Height="16" Fill="#FF22C55E"/>
                                    <Path Data="M4,8 L7,11 L12,5"
                                          Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
</Page>
