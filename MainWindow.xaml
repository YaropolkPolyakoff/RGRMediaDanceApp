<Window x:Class="DanceLearning.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dance Learning"
        Width="1200" Height="780"
        MinWidth="1024" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundDarkBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== LEFT NAVIGATION ===== -->
        <Border Grid.Column="0"
                Background="{StaticResource BackgroundNavBrush}"
                BorderBrush="#FF2E2E44" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App title -->
                <StackPanel Grid.Row="0" Margin="16,20,16,24">
                    <TextBlock Text="Dance Learning"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="студия танца"
                               Foreground="{StaticResource AccentBrush}"
                               FontFamily="Segoe UI" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Navigation buttons -->
                <StackPanel Grid.Row="1" Margin="8,0">
                    <Button x:Name="NavCatalogBtn"
                            Style="{StaticResource NavButtonActiveStyle}"
                            Click="NavCatalog_Click"
                            Content="Каталог стилей"
                            Margin="0,2"/>
                    <Button x:Name="NavPlayerBtn"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavPlayer_Click"
                            Content="Видеоплеер"
                            Margin="0,2"/>
                    <Button x:Name="Nav3DBtn"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Nav3D_Click"
                            Content="3D-демонстрация"
                            Margin="0,2"/>
                    <Button x:Name="NavProfileBtn"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavProfile_Click"
                            Content="Личный кабинет"
                            Margin="0,2"/>
                </StackPanel>

                <!-- Version -->
                <StackPanel Grid.Row="2" Margin="16,12,16,16">
                    <Separator Background="#FF2E2E44" Margin="0,0,0,8"/>
                    <TextBlock Text="v1.0.0"
                               Style="{StaticResource BodyStyle}"
                               FontSize="11" Opacity="0.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== CONTENT AREA ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BackgroundDarkBrush}"
                    BorderBrush="#FF2E2E44" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <TextBlock x:Name="PageTitleText"
                               Text="Каталог стилей"
                               Style="{StaticResource SubheadingStyle}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Page frame -->
            <Frame x:Name="MainFrame"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"/>
        </Grid>
    </Grid>
</Window>
